# Native Cloud Emulator Configuration
# Copy to .env.local and adjust for your environment

# Enable emulator features (requires Docker + KVM)
EMULATOR_ENABLED=false
NEXT_PUBLIC_EMULATOR_ENABLED=false

# Docker socket path
EMULATOR_DOCKER_HOST=/var/run/docker.sock

# Max concurrent emulator sessions
EMULATOR_MAX_SESSIONS=5

# Session timeout in minutes (auto-stop after inactivity)
EMULATOR_SESSION_TIMEOUT=15
