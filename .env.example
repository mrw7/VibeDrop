# VibeDrop Environment Variables (LOCAL)
#
# Copy this file to .env.local and fill in real values.
# ⚠️  Generate fresh secrets — do NOT reuse any value found in version control.
#     Any key that previously appeared in this repo must be treated as compromised.
#
# Generate secrets:
#   openssl rand -hex 16     # NEXTAUTH_SECRET
#   openssl rand -hex 32     # ENCRYPTION_KEY (must be ≥32 chars)

# ── Database ────────────────────────────────────────────────
# Local docker-compose provides a postgres:16 service:
#   user/password/db = vibedrop / vibedrop_dev / vibedrop
# docker-compose.yml overrides this for the app & worker services.
DATABASE_URL="postgresql://vibedrop:vibedrop_dev@localhost:5432/vibedrop"

# ── NextAuth.js ─────────────────────────────────────────────
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="REPLACE_WITH_openssl_rand_hex_16"

# ── GitHub OAuth ────────────────────────────────────────────
# Create at https://github.com/settings/developers
# Authorization callback URL: http://localhost:3000/api/auth/callback/github
GITHUB_CLIENT_ID="REPLACE_WITH_GITHUB_OAUTH_CLIENT_ID"
GITHUB_CLIENT_SECRET="REPLACE_WITH_GITHUB_OAUTH_CLIENT_SECRET"

# ── Alibaba Cloud OSS ───────────────────────────────────────
OSS_REGION="oss-us-west-1"
OSS_BUCKET="REPLACE_WITH_OSS_BUCKET_NAME"
OSS_ACCESS_KEY_ID="REPLACE_WITH_OSS_ACCESS_KEY_ID"
OSS_ACCESS_KEY_SECRET="REPLACE_WITH_OSS_ACCESS_KEY_SECRET"

# ── Encryption (for GitHub tokens) ──────────────────────────
# MUST be ≥32 chars. Changing this orphans already-encrypted GitHub tokens.
ENCRYPTION_KEY="REPLACE_WITH_openssl_rand_hex_32_at_least_32chars"

# ── Admin (optional) ────────────────────────────────────────
# Comma-separated GitHub user IDs that can access /admin
# ADMIN_GITHUB_IDS=""

# ── Email / password auth (optional — dev logs links to console) ──
# SMTP_HOST=""
# SMTP_PORT="587"
# SMTP_USER=""
# SMTP_PASS=""
# EMAIL_FROM=""

# ── Tipping / Stripe (optional) ─────────────────────────────
# STRIPE_SECRET_KEY="sk_test_..."
# STRIPE_WEBHOOK_SECRET="whsec_..."

# ── Native cloud emulator (optional — needs Docker + KVM) ───
# EMULATOR_ENABLED="false"
# EMULATOR_DOCKER_HOST="/var/run/docker.sock"
# EMULATOR_MAX_SESSIONS="5"
# EMULATOR_SESSION_TIMEOUT="15"
