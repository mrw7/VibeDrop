# VibeDrop Environment Variables (PRODUCTION — Alibaba Cloud ECS)
#
# Copy this file to .env.production and fill in REAL values before deploying.
# ⚠️  NEVER commit .env.production. Rotate all secrets before going live.
#     Any key that appeared in version control is compromised.
#
# Generate secrets ON THE SERVER (not on your dev machine):
#   openssl rand -hex 16     # NEXTAUTH_SECRET
#   openssl rand -hex 32     # ENCRYPTION_KEY

# ── Database (Alibaba Cloud Supabase / RDS) ─────────────────
# PgBouncer note: if connecting through PgBouncer, append
#   ?pgbouncer=true&connection_limit=1
# and set a directUrl for migrations if needed.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/vibedrop?sslmode=require"

# ── Domain (used by nginx + NextAuth) ───────────────────────
# Must match the DNS A record pointing to this ECS instance.
NEXTAUTH_URL="https://YOUR_DOMAIN"

# Also set in the compose env (DOMAIN) for nginx templating:
# DOMAIN=YOUR_DOMAIN

# ── NextAuth.js ─────────────────────────────────────────────
NEXTAUTH_SECRET="GENERATE_FRESH_openssl_rand_hex_16"

# ── GitHub OAuth ────────────────────────────────────────────
# Authorization callback URL: https://YOUR_DOMAIN/api/auth/callback/github
GITHUB_CLIENT_ID="YOUR_GITHUB_OAUTH_CLIENT_ID"
GITHUB_CLIENT_SECRET="YOUR_GITHUB_OAUTH_CLIENT_SECRET"

# ── Alibaba Cloud OSS ───────────────────────────────────────
OSS_REGION="oss-us-west-1"
OSS_BUCKET="YOUR_OSS_BUCKET"
OSS_ACCESS_KEY_ID="YOUR_OSS_ACCESS_KEY_ID"
OSS_ACCESS_KEY_SECRET="YOUR_OSS_ACCESS_KEY_SECRET"

# ── Encryption (for GitHub tokens) ──────────────────────────
# MUST be ≥32 chars. Keep stable — rotating orphans encrypted GitHub tokens.
ENCRYPTION_KEY="GENERATE_FRESH_openssl_rand_hex_32"

# ── Admin ───────────────────────────────────────────────────
# Comma-separated GitHub user IDs with /admin access
ADMIN_GITHUB_IDS="YOUR_GITHUB_USER_ID"

# ── Email (required for email/password auth in production) ──
SMTP_HOST="smtp.YOUR_PROVIDER.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="YOUR_SMTP_USER"
SMTP_PASS="YOUR_SMTP_PASSWORD"
EMAIL_FROM="noreply@YOUR_DOMAIN"

# ── Tipping / Stripe ────────────────────────────────────────
# Use live keys (sk_live_...) for real payments, test keys (sk_test_...) to trial.
# Configure webhook endpoint in Stripe Dashboard:
#   https://YOUR_DOMAIN/api/webhooks/stripe
STRIPE_SECRET_KEY="sk_live_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# ── Native cloud emulator (default OFF — needs KVM) ─────────
EMULATOR_ENABLED="false"
NEXT_PUBLIC_EMULATOR_ENABLED="false"
# EMULATOR_DOCKER_HOST="/var/run/docker.sock"
# EMULATOR_MAX_SESSIONS="5"
# EMULATOR_SESSION_TIMEOUT="15"
